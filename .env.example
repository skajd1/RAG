# Confluence Settings
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_EMAIL=your_email@example.com
CONFLUENCE_API_TOKEN=your_atlassian_cloud_api_token_here
# Optional legacy fallback. For Confluence Cloud, prefer CONFLUENCE_EMAIL + CONFLUENCE_API_TOKEN.
CONFLUENCE_PAT=

# Jira Settings
# Optional overrides. Leave these empty to reuse the Atlassian Cloud
# CONFLUENCE_URL / CONFLUENCE_EMAIL / CONFLUENCE_API_TOKEN values.
# Jira REST calls are made against the Atlassian site root, not /wiki or /jira.
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_INGEST_MAX_ISSUES=1000
JIRA_INGEST_MAX_COMMENTS_PER_ISSUE=20
JIRA_REQUEST_TIMEOUT_SECONDS=90

# AI Model Settings
OLLAMA_MODEL=qwen3.5:9b
EMBEDDING_MODEL=qwen3-embedding:8b
OLLAMA_NUM_CTX=4096
# Larger window used only for multi-page monthly summaries inside a selected Confluence space.
OLLAMA_AGGREGATION_NUM_CTX=8192
OLLAMA_NUM_PREDICT=8192
OLLAMA_REASONING=false
OLLAMA_HEALTH_TIMEOUT_SECONDS=3
RAG_TOP_K=5
RAG_KEYWORD_TOP_K=3
RAG_JIRA_STATUS_TOP_K=5
RAG_CONTEXT_EXPAND_CHUNKS=20
RAG_MAX_CONTEXT_CHARS=18000
RAG_TIMEOUT_SECONDS=45
RAG_CHAT_HISTORY_TURNS=8
RAG_CHAT_HISTORY_MAX_CHARS=4000
RAG_CONVERSATION_HINT_MAX_CHARS=1000
RAG_PRIOR_SOURCE_LIMIT=4
RAG_PRIOR_SOURCE_CHUNKS=12

# Deterministic RAG route profile overrides
RAG_ROUTE_EXACT_LOOKUP_TOP_K=4
RAG_ROUTE_EXACT_LOOKUP_KEYWORD_TOP_K=6
RAG_ROUTE_EXACT_LOOKUP_EXPAND_CHUNKS=12
RAG_ROUTE_EXACT_LOOKUP_MAX_CONTEXT_CHARS=12000
RAG_ROUTE_LONG_DOC_LOOKUP_LONG_DOC_NEIGHBOR_WINDOW=4
RAG_ROUTE_LONG_DOC_DETAIL_LONG_DOC_DETAIL_CHUNKS=48
RAG_ROUTE_LONG_DOC_SUMMARY_LONG_DOC_SUMMARY_WINDOW_CHUNKS=8

# Query Logging
QUERY_LOG_ENABLED=true
QUERY_LOG_DIR=runtime-logs/query
QUERY_LOG_INCLUDE_RAW_TEXT=false
QUERY_LOG_RETENTION_DAYS=30

CONFLUENCE_REQUEST_TIMEOUT_SECONDS=90
INGEST_MAX_CHUNK_CHARS=6000

# Scheduled Ingestion
# Runs all Confluence/Jira sources already indexed in Qdrant.
# Defaults target low-traffic windows: dawn and lunch.
INGEST_SCHEDULER_ENABLED=true
INGEST_SCHEDULE_TIMES=03:00,12:30
INGEST_SCHEDULE_TIMEZONE=Asia/Seoul
INGEST_SCHEDULE_CATCHUP=true
INGEST_SCHEDULE_WINDOW_MINUTES=10
INGEST_SCHEDULER_POLL_SECONDS=30
INGEST_SCHEDULE_STATE_FILE=.ingest_schedule_state.json

# Local App Settings
TZ=Asia/Seoul
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://localhost:8000
# Temporary internal network allowlist for backend HTTP access.
# Keep loopback for local/proxy calls and allow the office gateway subnet.
INTERNAL_ALLOWED_CIDRS=127.0.0.1/32,::1/128,10.0.0.0/24

# Remote AI Infrastructure on Remote AI Server
# Replace this host with the reachable remote AI server address from your local machine.
OLLAMA_HOST=http://remote-ai-host:11434
QDRANT_HOST=http://remote-ai-host:6333
